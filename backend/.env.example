# Environment configuration template
# Copy to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/traffic_violations

# ── AI / Detection ────────────────────────────────────────────────────────────
# Use "cuda" if you have an NVIDIA GPU; "cpu" otherwise
YOLO_DEVICE=cpu
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45

# ── OCR Engine ────────────────────────────────────────────────────────────────
# Options: "easyocr" | "paddleocr"
OCR_ENGINE=easyocr

# ── Storage ───────────────────────────────────────────────────────────────────
EVIDENCE_DIR=./evidence
UPLOAD_DIR=./uploads

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=Traffic Violation Detection System
